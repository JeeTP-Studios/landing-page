          "enabled": true,
          "title": "Impact",
          "items": [
            {
              "heading": "Development",
              "body": "Development of the final, tested version over a two-month period"
            },
            {
              "heading": "Over 60,000 users",
              "body": "An experience enjoyed by more than 60,000 users (Club Premier members, now Aeromexico Rewards)"
            },
            {
              "heading": "No errors",
              "body": "There were no production errors that could have affected the user's score. This was very important, as there were big prizes up for grabs, such as trips and SUVs."
            },
            {
              "heading": "Successful report",
              "body": "Weekly reports were submitted to verify the authenticity of each user's games, including a review of high scores in relation to game duration and the number of games redeemed."
